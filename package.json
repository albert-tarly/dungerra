{
  "name": "dungeon-game-ts",
  "version": "1.0.0",
  "description": "Dungerra, a multiplayer dungeon exploration game.",
  "main": "dist/main.js",
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "cross-env NODE_ENV=production webpack --mode production",
    "build:desktop": "cross-env NODE_ENV=production DUNGERRA_TARGET=desktop webpack --mode production",
    "dev": "webpack serve --mode development --open",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.2",
    "dungerra-api": "github:albert-tarly/dungerra-api",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "html-webpack-plugin": "^5.6.5",
    "prettier": "^3.4.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.11.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.73.0",
    "uuid": "^11.0.3",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^6.1.0"
  },
  "engines": {
    "node": ">=26"
  }
}
